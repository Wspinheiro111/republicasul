{
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.php", "destination": "/", "statusCode": 301 },
    { "source": "/tradicionais_trama_republicasul.php", "destination": "/catalogo/lencos-tradicionais/", "statusCode": 301 },
    { "source": "/carijos1.php", "destination": "/catalogo/carijo-uma-cor/", "statusCode": 301 },
    { "source": "/medidas_especiais.php", "destination": "/catalogo/carijo-duas-cores/", "statusCode": 301 },
    { "source": "/controle_artigos.php", "destination": "/catalogo/carijo-duas-cores/", "statusCode": 301 },
    { "source": "/farroupilha.php", "destination": "/catalogo/farroupilha/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
